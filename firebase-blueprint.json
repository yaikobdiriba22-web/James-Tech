{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project completed by James Tech",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the project"
        },
        "title": {
          "type": "string",
          "description": "Title of the project"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the project"
        },
        "image": {
          "type": "string",
          "description": "URL or path to the project thumbnail image"
        },
        "category": {
          "type": "string",
          "enum": [
            "Web Development",
            "Full-Stack Applications",
            "IT Support",
            "Network Administration",
            "Digital Solutions"
          ],
          "description": "Category of the technology service"
        },
        "technologies": {
          "type": "array",
          "description": "List of tech stack keywords"
        },
        "githubUrl": {
          "type": "string",
          "description": "GitHub repository URL"
        },
        "liveUrl": {
          "type": "string",
          "description": "Live deployment URL"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether to highlight this project on the homepage"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "technologies",
        "featured"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A message submitted through the contact form",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the message"
        },
        "name": {
          "type": "string",
          "description": "Name of the sender"
        },
        "email": {
          "type": "string",
          "description": "Email of the sender"
        },
        "subject": {
          "type": "string",
          "description": "Subject of the message"
        },
        "message": {
          "type": "string",
          "description": "Content of the message"
        },
        "status": {
          "type": "string",
          "enum": [
            "unread",
            "read",
            "archived"
          ],
          "description": "Current processing status of the message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        }
      },
      "required": [
        "name",
        "email",
        "subject",
        "message",
        "status",
        "createdAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "An administrative user record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User UID"
        },
        "email": {
          "type": "string",
          "description": "Email of the administrator"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin"
          ],
          "description": "Administrative role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Role assignment timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "role",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of showcase projects done by James Tech"
    },
    "contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Submitted contact messages for the James Tech team"
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "List of users with admin privileges"
    }
  }
}
